venv/
__pycache__/
*.pyc
data/*.parquet
data/*.json
# The morning order slate, regenerated by cron every weekday. Its .json twin
# was always ignored; the .txt was committed by accident and would otherwise
# leave the tree dirty every single morning.
data/orders_today.txt
# Generated every morning by fund_report.py, same as the slate.
data/fund_report.txt
data/claude_fund.txt
# Rewritten by daily.sh every morning; tracking them dirties the tree daily.
data/daily_book.txt
# Written by lab_loop.sh; the watchdog reads it for liveness.
data/lab_loop.pid
data/stop_sweep.json
data/lab_loop_summary.log
data/*.html
data/*.db
data/raw/
data/symbol_snapshots/
data/archive_snapshots/
data/french/
logs/*.log
models/*.json
.env

# SQLite databases and their write-ahead logs. NEVER version these.
# A tracked -wal/-shm is not merely large: `git checkout` will drop a stale
# write-ahead log on top of a live database and corrupt it. That happened on
# 2026-09-12 and cost a rebuild of market_data.db.
data/*.db
data/*.db-wal
data/*.db-shm

data/edgar/

data/sec_fundamentals/

# Backups. The small forward archive IS tracked on purpose — committing it is
# what gets the irreplaceable forward record off this machine on every push.
# The listings archives are 8 MB each and change rarely; copy those deliberately.
backups/listings_*.sql.gz

# Truth-set snapshots are large binary databases. The MANIFEST is tracked — it
# carries the version, window, row counts and sha256 that results cite, and is
# what makes a claim checkable. The .db files are rebuildable from the manifest's
# parameters and must not bloat the repo.
truth_sets/*.db

# FINSABER downloads (Hugging Face finsaber-team/FINSABER-reproduce). Data, not source.
data/finsaber/

# Addendum C data (regenerable from the database); the JSON reports are committed.
data/universe/*.parquet
